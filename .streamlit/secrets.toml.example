# Copie este arquivo para .streamlit/secrets.toml e preencha com os dados do seu projeto Supabase.
# O secrets.toml real nunca deve ir para o controle de versão (já está no .gitignore).

# Supabase > Project Settings > API
SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_KEY = "sua-chave-do-supabase"

# Opcional: aparecem no cabeçalho do relatório em PDF
NOME_USUARIO = "Seu nome"
EMPRESA = "Nome da empresa"
